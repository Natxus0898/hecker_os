<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:minHeight="64dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <FrameLayout
        android:id="@+id/icon_frame"
        android:layout_width="40dp"
        android:layout_height="40dp">
        <androidx.preference.internal.PreferenceImageView
            android:layout_gravity="center"
            android:id="@android:id/icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:scaleType="centerInside" />
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/text_frame"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingStart="14dp"
        android:paddingEnd="8dp">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/hecker_foreground"
            android:id="@android:id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2" />
        <TextView
            android:textSize="11sp"
            android:textColor="@color/hecker_secondary"
            android:id="@android:id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="3" />
    </LinearLayout>
    <FrameLayout
        android:id="@+id/alert_frame"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="8dp">
        <TextView
            android:textSize="26sp"
            android:textColor="@color/hecker_accent"
            android:gravity="center"
            android:id="@+id/alert_unnumbered"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="•"
            android:importantForAccessibility="no" />
        <FrameLayout
            android:id="@+id/alert_numbered_frame"
            android:background="@drawable/hecker_icon_background"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/hecker_accent"
                android:gravity="center"
                android:id="@+id/alert_number_fg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no" />
        </FrameLayout>
    </FrameLayout>
    <TextView
        android:textSize="25sp"
        android:textColor="@color/hecker_secondary"
        android:layout_width="16dp"
        android:layout_height="wrap_content"
        android:text="›"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:orientation="vertical"
        android:id="@android:id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</LinearLayout>
